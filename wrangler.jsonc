{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-projects-rest-api",
	"main": "src/index.js",
	"compatibility_date": "2026-10-13",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "project-db",
			"database_id": "87a266a6-a305-4e64-a57d-4f2d91338878",
      "migrations_dir": "./src/data/migrations",
		},
	],
    "ratelimits": [
      {
        "name": "AUTH_LIMITER",
        "namespace_id": "1001",
        "simple": {
          "limit": 10,
          "period": 60
        },
      },
    ],
}
